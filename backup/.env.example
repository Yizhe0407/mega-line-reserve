# 專用最低權限 MySQL 備份帳號；禁止使用 root。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=mega_backup
MYSQL_DATABASE=mega_line_reserve
# Compose 會將此密碼檔掛載為 /run/secrets/backup_mysql_password。
MYSQL_PASSWORD_FILE=/run/secrets/backup_mysql_password

# 本地備份與排程設定
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE_TIME=02:00
RUN_ON_STARTUP=false
TZ=Asia/Taipei

# 遠端上傳預設關閉；啟用時只接受 type=crypt 的 remote。
ENABLE_RCLONE_UPLOAD=false
RCLONE_CRYPT_REMOTE=backup-crypt:mega-line-reserve
RCLONE_CONFIG=/config/rclone/rclone.conf
