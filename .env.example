# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mega_line_reserve
MYSQL_USER=mega_user
MYSQL_PASSWORD=mega_password

# Backend Configuration
DATABASE_URL=mysql://mega_user:mega_password@mysql:3306/mega_line_reserve
NODE_ENV=production
# 不可設為 *：搭配 credentials 會允許任意網站帶憑證呼叫 API，請填寫實際前端網域（可逗號分隔多個）
CORS_ORIGIN=https://mega.yizhe.dev
# 反向代理層數（rate limit 取得真實 client IP 用）。單層 nginx/Cloud Run 填 1；未設則 production 預設 1
TRUST_PROXY=1

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://mega.yizhe.dev
NEXT_PUBLIC_LIFF_ID=

# LINE Configuration (後端)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

BACKUP_RETENTION_DAYS=7
ENABLE_GDRIVE_UPLOAD=true
GDRIVE_BACKUP_PATH=mysql-backups
TZ=Asia/Taipei
