# ========================================
# MySQL
# ========================================
# 正式環境請改用密碼管理器產生的高熵、URL-safe 密碼，不要沿用範例值。
# Compose 會將應用帳號密碼放入 Prisma DATABASE_URL，建議使用 `openssl rand -hex 32`。
MYSQL_ROOT_PASSWORD=replace-with-a-high-entropy-root-secret
MYSQL_DATABASE=mega_line_reserve
MYSQL_USER=mega_user
MYSQL_PASSWORD=replace-with-a-high-entropy-app-secret

# 僅供非 Compose 工具參考；Compose 會依上述變數組合容器內 DATABASE_URL。
DATABASE_URL=mysql://mega_user:replace-with-a-high-entropy-app-secret@mysql:3306/mega_line_reserve

# ========================================
# Backend production
# ========================================
NODE_ENV=production
# 必填，不可設為 *；多個公開來源可用逗號分隔。
CORS_ORIGIN=https://reserve.example.com
# Next rewrite 會原樣保留 X-Forwarded-For，預設必須為 false。
# 只有前方代理會覆寫／清理轉送標頭時，才可改成該代理的明確 IP/CIDR。
TRUST_PROXY=false

# LINE 後端驗證設定
LINE_CHANNEL_ID=

# ========================================
# Frontend build-time
# ========================================
# Production Compose 會明確把 NEXT_PUBLIC_API_URL 建置為空字串；瀏覽器固定使用同源 /api。
# 不要在 production .env 放入公開 Backend URL，內部轉發只由 INTERNAL_API_URL 控制。
NEXT_PUBLIC_LIFF_ID=

# ========================================
# 加密資料庫備份
# ========================================
# 必須先由資料庫管理員建立只有 SELECT、SHOW VIEW、TRIGGER 權限的專用帳號。
BACKUP_MYSQL_USER=mega_backup
# 指向只含密碼內容、權限為 0600 的檔案；不要將檔案提交到 Git。
BACKUP_MYSQL_PASSWORD_FILE=${HOME}/.config/mega-line-reserve/backup_mysql_password
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE_TIME=02:00
RUN_ON_STARTUP=false

# 啟用後 RCLONE_CRYPT_REMOTE 必須指向 type=crypt 的 rclone remote。
ENABLE_RCLONE_UPLOAD=false
RCLONE_CRYPT_REMOTE=backup-crypt:mega-line-reserve

# 容器與業務時區
TZ=Asia/Taipei
